# Settings the Arduino component and this board require. Having these in
# the project -- rather than discovering them from a build failure -- is
# the main thing ESP-IDF buys over the Arduino framework alone, and the
# reason the project had to move to a path with no spaces in it.

# esp32-arduino refuses to build at any other tick rate.
CONFIG_FREERTOS_HZ=1000

# ESP32-S3-WROOM-1U-N16R8: 16 MB QIO flash, 8 MB OCTAL PSRAM.
# Build this as the stock devkit instead and the firmware boots, reports
# 8 MB and no PSRAM, and the mistake looks like a hardware fault.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console on the native USB. GPIO43 and GPIO44, the ROM UART pads, are
# the LED data line and the charger enable on this board, so UART0 must
# never be opened on them.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# A task that stops feeding the watchdog should be reported, not
# silently tolerated; the supervisor reports stalls too, but only while
# it is itself alive.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Keep a core dump on panic: a field unit that crashes once a week is
# only diagnosable if it leaves something behind.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# BLE for the iOS app (P5): NimBLE, peripheral only, one connection.
# LE Secure Connections with the passkey shown on the e-paper, so a
# phone that changes settings or starts a trip has been paired by
# someone holding the box. Bonds live in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# The NimBLE host logs every GAP procedure at INFO, which buries the
# console. Warnings and errors only.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Wi-Fi + BLE + MQTT do not fit in internal RAM alongside everything
# else: measured, the console task could not get its stack (3 KB left).
# The 8 MB of PSRAM takes what does not need internal RAM: NimBLE's
# pools, Wi-Fi/LWIP buffers where possible, and large static buffers
# marked EXT_RAM_BSS_ATTR. Wi-Fi's IRAM speed-ups are given up -- on the
# S3 IRAM is carved from the same SRAM, and throughput does not matter.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# P7: every wake from deep sleep is a boot, so boot time is battery.
# The 8 MiB PSRAM test alone is a few hundred ms at full current, and
# re-hashing the 1.3 MB image after a sleep proves nothing a power-on
# check has not (no secure boot on this product yet -- see P8).
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

# P7: dynamic frequency scaling and automatic light sleep are available;
# what is used is decided at run time (esp_pm_configure).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# OTA (src/ota.h). A new image boots on probation and is kept only once
# it reaches the broker; otherwise the bootloader goes back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Images must be signed (RSA-3072, the Secure Boot V2 scheme) to be
# accepted as an update. No eFuse is burned and the bootloader does not
# check at power-on: this guards the network path, and USB flashing still
# works. The signing is done by tools/sign_app.py after the build, with a
# key kept off the repository, so the IDF build itself signs nothing.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
# The signature, not the transport, is what makes an image acceptable, so
# a plain-HTTP file server is allowed too (https is used when given).
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# USB drive (F2, 2026-10-05): with USB power the port becomes a serial port
# (the console) and a read-only drive at once -- TinyUSB, through the
# vendored components/esp_tinyusb. Until it starts the console is on the
# USB-Serial-JTAG as before, and `flash` hands the port back to it.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="mCOLD"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="mCOLD Foam V1"
CONFIG_TINYUSB_DESC_SERIAL_STRING="0"
CONFIG_TINYUSB_DESC_CDC_STRING="mCOLD console"
CONFIG_TINYUSB_DESC_MSC_STRING="mCOLD drive"
